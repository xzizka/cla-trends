apiVersion: 1

datasources:
  - name: TimescaleDB
    uid: timescaledb
    type: postgres
    access: proxy
    url: timescaledb:5432
    database: "{{ timescaledb_db }}"
    user: "{{ timescaledb_grafana_ro_user }}"
    isDefault: true
    editable: false
    jsonData:
      database: "{{ timescaledb_db }}"
      sslmode: disable
      postgresVersion: 1800
      timescaledb: true
    secureJsonData:
      password: "{{ vault_timescaledb_grafana_ro_password }}"
