[Unit]
Description=Grafana
After=network-online.target {{ podman_network_name }}-network.service timescaledb.service
Wants=timescaledb.service

[Container]
Image={{ grafana_image }}
ContainerName=grafana
Network={{ podman_network_name }}.network
Volume={{ grafana_volume }}.volume:/var/lib/grafana
Volume=%h/grafana-provisioning/datasources:/etc/grafana/provisioning/datasources:Z,ro
Volume=%h/grafana-provisioning/dashboards-provider:/etc/grafana/provisioning/dashboards:Z,ro
Volume=%h/grafana-provisioning/dashboards-json:/var/lib/grafana/dashboards:Z,ro
Environment=GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
Environment=GF_SECURITY_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
Environment=GF_USERS_ALLOW_SIGN_UP=false
PublishPort=0.0.0.0:{{ grafana_port }}:3000
HealthCmd=wget -q -O- http://127.0.0.1:3000/api/health
HealthInterval=15s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=always
# generous: the first pull of this image can take a long time on a slow link
TimeoutStartSec=1800

[Install]
WantedBy=default.target
