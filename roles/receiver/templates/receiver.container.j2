[Unit]
Description=Prometheus remote_write receiver -> TimescaleDB
After=network-online.target {{ podman_network_name }}-network.service timescaledb.service
Wants=timescaledb.service

[Container]
Image=localhost/{{ receiver_image_name }}:{{ receiver_image_tag }}
ContainerName=receiver
Network={{ podman_network_name }}.network
Environment=RECEIVER_PORT={{ receiver_port }}
Environment=RECEIVER_BEARER_TOKEN={{ vault_receiver_bearer_token }}
Environment=RECEIVER_PG_DSN=postgresql://{{ timescaledb_receiver_user }}:{{ vault_timescaledb_receiver_password }}@timescaledb:5432/{{ timescaledb_db }}
PublishPort=0.0.0.0:{{ receiver_port }}:{{ receiver_port }}
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ receiver_port }}/healthz', timeout=3)"
HealthInterval=15s
HealthRetries=5
HealthStartPeriod=15s

[Service]
Restart=always

[Install]
WantedBy=default.target
