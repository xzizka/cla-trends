[Unit]
Description=TimescaleDB metrics store
After=network-online.target {{ podman_network_name }}-network.service

[Container]
Image={{ timescaledb_image }}
ContainerName=timescaledb
Network={{ podman_network_name }}.network
# PG18+ docker-library images changed convention: they want a single mount
# at /var/lib/postgresql and place data in a version-specific subdirectory
# themselves (pg_ctlcluster-style), refusing to start if pointed straight at
# .../data the pre-18 way. Revisit this path if downgrading below pg18.
Volume={{ timescaledb_volume }}.volume:/var/lib/postgresql
# NOT mounted at /docker-entrypoint-initdb.d on purpose: CREATE EXTENSION
# timescaledb triggers an internal PostgreSQL restart, which raced with the
# entrypoint's own automatic initdb.d run often enough (bug-014/015 in
# buglog.json) to make that path unreliable. Ansible applies this SQL
# explicitly and idempotently instead (roles/timescaledb/tasks/main.yml) —
# this mount just makes the files available inside the container for that.
Volume=%h/timescaledb-init:/opt/sql-init:Z,ro
Environment=POSTGRES_DB={{ timescaledb_db }}
Environment=POSTGRES_USER={{ timescaledb_superuser }}
Environment=POSTGRES_PASSWORD={{ vault_timescaledb_superuser_password }}
Environment=TIMESCALEDB_TELEMETRY=off
# loopback-only publish: convenient for `psql` from the host itself; Grafana
# and the receiver reach this container over the internal pod network by
# name ("timescaledb"), never through this published port.
PublishPort=127.0.0.1:5432:5432
HealthCmd=pg_isready -U {{ timescaledb_superuser }} -d {{ timescaledb_db }}
HealthInterval=15s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=always
# generous: the first pull of this image can take a long time on a slow link
TimeoutStartSec=1800

[Install]
WantedBy=default.target
