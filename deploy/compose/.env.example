# Copy to .env and fill in. `.env` holds secrets — chmod 600 it.
# Generate passwords e.g. with:  openssl rand -base64 24

# Image version (all four images share one tag) and Docker Hub namespace
STACK_VERSION=1.1.0
REGISTRY_NS=lojdr

# Database passwords
POSTGRES_PASSWORD=
RECEIVER_DB_PASSWORD=
IMPORTER_DB_PASSWORD=
GRAFANA_RO_DB_PASSWORD=

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Token Prometheus must send in remote_write (Authorization: Bearer ...)
RECEIVER_BEARER_TOKEN=

# Ports. Grafana and the receiver listen on all interfaces; set *_BIND to
# 127.0.0.1 to keep them local. TimescaleDB and importer status are
# loopback-only.
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000
RECEIVER_BIND=0.0.0.0
RECEIVER_PORT=9201
TIMESCALEDB_PORT=5432
IMPORTER_STATUS_PORT=9202

IMPORTER_LOG_LEVEL=INFO
