# Copy to importer.env. Secrets for importer sources — referenced from
# config/sources.yml as ${NAME}. Any name works; the IMPORTER_CRED_ prefix is
# just a convention. After a change:  docker compose up -d importer
#
# IMPORTER_CRED_PROM_MAIN_TOKEN=...
# IMPORTER_CRED_MIMIR_TOKEN=...
# IMPORTER_CRED_INFLUX_LEGACY_PASSWORD=...
